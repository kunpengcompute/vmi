        if [ $end_id -gt $MAX ]; then
            end_id=$MAX
        fi
        while [ $start_id -le $MAX ];
        do
            for container_id in $(seq $start_id $end_id); do
                cmd="$THISDIR/cfct_video tstart $container_id"
                LOG_INFO $cmd
                $cmd >/dev/null 2>&1 &
                pids+=($!)
            done
