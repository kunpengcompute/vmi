    cp -r ${tmp_xd_libs}/innogpu/opengles/arm64/libufwriter.so ${tmp_xd_libs}/system/vendor/lib64/
    cp -r ${tmp_xd_libs}/innogpu/opengles/arm/libusc.so ${tmp_xd_libs}/system/vendor/lib/
