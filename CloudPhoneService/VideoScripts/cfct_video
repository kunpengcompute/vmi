    fi

    VIDEO_USERDATA_MAP=(${VIDEO_USERDATA_MAP_CORE[*]})
    VIDEO_ENC_MAP=(${VIDEO_ENC_MAP_CORE[*]})

    if [ ${#amd_gpus[@]} -ne 0 ]; then
