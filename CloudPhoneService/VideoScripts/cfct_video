# 初始化视频流运行时环境变量（THISDIR、CFCT_CFG 等）
# 必须在 main 入口最早调用
function init_video_env() {
    bb_init_runtime_env
    CFCT_CFG=$THISDIR/cfct_config
    if [ ! -f "$CFCT_CFG" ]; then
        bb_exit_error "Can not find file $CFCT_CFG"
    fi
    source $CFCT_CFG
    bb_log_info "$CFCT_CFG loaded"

    DOCKER_NAME_PREFIX="android_"  # must end with "_"
    DEFAULT_PROP=$THISDIR/default.prop
    ENC_PACKAGE=$THISDIR/NETINT.tar.gz

    bb_init_hardware_config

    bb_check_environment
    bb_log_info "Default container runtime selected: ${DEFAULT_RUNTIME}"
}

function check_hardware_map() {
    for ((i=0; i<${#CPU_MAP[@]}; i++)); do
        local cpus=()
        IFS=',' read -r -a cpus <<< ${CPU_MAP[i]}
        local lim=$(bb_get_num_of_cpus)
        for ((j=0; j<${#cpus[@]}; j++)); do
            if [ ${cpus[j]} -ge $lim ]; then
                bb_exit_error "The number ${cpus[j]} in CPU_MAP exceeds the number of cpus 0-$((${lim}-1))."
            fi
        done
    done
    for ((i=0; i<${#GPU_MAP[@]}; i++)); do
        if [ ! -e ${GPU_MAP[i]} ]; then
            bb_exit_error "The ${GPU_MAP[i]} in GPU_MAP doesn't exist."
        fi
    done
    if [ ${#amd_gpus[@]} -ne 0 ]; then
        for ((i=0; i<${#ENC_MAP[@]}; i++)); do
            local encs=()
            IFS=',' read -r -a encs <<< ${ENC_MAP[i]}
            for ((j=0; j<${#encs[@]}; j++)); do
                if [ ! -e ${encs[j]} ]; then
                    bb_exit_error "The ${encs[j]} in ENC_MAP doesn't exist."
                fi
            done
        done
    fi
}

function param_check_container_name() {
    local container_name=$1
    local status=$2
    local opts="-a"
    [ "$status" == "RUNNING" ] && opts=""
    if [ -z "$container_name" ] ; then
        bb_log_error "Container name is not specified!"
    elif ! echo "$container_name" | grep -q "$DOCKER_NAME_PREFIX" ; then
        bb_log_error "Container name does not start with '$DOCKER_NAME_PREFIX'"
    elif ! $RUNTIME_CMD ps $opts | grep -w -q "$container_name" ; then
        if [ "$status" == "RUNNING" ] ; then
            bb_log_error "Container named $container_name is not running!"
        else
            bb_log_error "Container named $container_name doesn't exist!"
        fi
    else
        return 0
    fi
    bb_log_error "Please specify container name below"
    $RUNTIME_CMD ps $opts
    exit 1
}

function param_check_image_id_or_name() {
    local image=$1
    local name=${image%:*}
    local ver=${image#*:}
    if [ -z "$image" ] ; then
        bb_log_error "Container image ID is not specified!"
    elif ! $RUNTIME_CMD images | grep -q "$name" ; then
        bb_log_error "Container image $image doesn't exist"
    elif ! $RUNTIME_CMD images | grep -q "$ver" ; then
        bb_log_error "Container image $image doesn't exist"
    else
        return 0
    fi
    bb_log_error "Please select the image below"
    $RUNTIME_CMD images
    exit 1
}

function init_quadra() {
    # Quadra采用ni_rsrc_mon自启动，生命周期由编码卡厂家管理，此处仅打印返回值
    local container_name=$1
    local ni_init_success=$($RUNTIME_CMD exec -i ${container_name} getprop ni_rsrc_init_completed)
    if [ "${ni_init_success}" == "yes" ]; then
        bb_log_info "$container_name netint devices ready"
    else
        bb_log_warn "ni_rsrc_init_completed is not ready"
    fi
}

function init_netint_t432() {
    local container_name=$1
    local starttime=$(date +%s)
    local currenttime=$starttime
    local cmd="$RUNTIME_CMD exec -d $container_name sh -c \"test -f /system/vendor/bin/ni_rsrc_mon_logan\" > /dev/null 2>&1 &"
    local result=$(bb_wait_cmd "${cmd}")
    if [ ${result} == 1 ]; then
        bb_log_warn "${container_name} /system/vendor/bin/ni_rsrc_mon_logan not exist"
    elif [ ${result} -eq -1 ]; then
        bb_log_warn "${container_name} wait_cmd timeout, continue"
    else
        $RUNTIME_CMD exec -i $container_name /vendor/bin/ni_rsrc_mon_logan
        if [ $DEFAULT_RUNTIME == "docker" ]; then
            local netint_nums=$($RUNTIME_CMD inspect --format='{{range .HostConfig.Devices}}{{.PathOnHost}} {{end}}' $container_name | grep -o 'nvme[0-9]n' | wc -l)
        else
            # need config confirmation
            local netint_nums=0
        fi
        if [ $netint_nums -eq 0 ]; then
            bb_log_warn "Netint device doesn't exist."
            return
        fi
        netint_nums=$(($netint_nums - 1))
        while :
        do
            sleep 1
            currenttime=$(date +%s)
            printf "\033[1;36m[INFO] wait netint devices to be ready %ds\033[0m\n" $(($currenttime-$starttime))
            if [ $(($currenttime-$starttime)) -ge 19 ]; then
                bb_exit_error "${container_name} wait_cmd timeout, exit!"
                exit
            fi
            cmd="$RUNTIME_CMD exec -i $container_name sh -c \"test -f /dev/shm_netint/NI_LOGAN_lck_d${netint_nums}\" > /dev/null 2>&1 &"
            result=$(bb_wait_cmd "${cmd}")
            if [ ${result} == 1 ]; then
                continue
            elif [ ${result} -eq -1 ]; then
                bb_exit_error "${container_name} wait_cmd timeout, exit!"
            fi
            cmd="$RUNTIME_CMD exec -i $container_name sh -c \"test -f /dev/shm_netint/NI_LOGAN_lck_e${netint_nums}\" > /dev/null 2>&1 &"
            result=$(bb_wait_cmd "${cmd}")
            if [ ${result} == 1 ]; then
                continue
            elif [ ${result} -eq -1 ]; then
                bb_exit_error "${container_name} wait_cmd timeout, exit!"
            fi
            break
        done
        $RUNTIME_CMD exec -d $container_name chmod 666 /dev/nvm*n*
        $RUNTIME_CMD exec -d $container_name chmod 777 -R /dev/shm_netint
        bb_log_info "$container_name netint devices ready"
    fi
}

function webrtc_conection_configure() {
    local start_cmd="$1"
    if [ -f $DEFAULT_PROP ]; then
        local serverip=$(grep "vmi.webrtc.connection.serverip" $DEFAULT_PROP | awk -F= '{print $2}' | tr -d '\r')
        if [ ${serverip} = "0.0.0.0" ]; then
            bb_exit_error "Server IP is null in default.prop"
        fi
    else
        bb_exit_error "No default.prop for webrtc connection configuration"
    fi
    local networktype=4
    local map_http_port=$((8000+$container_id))
    local udp_port_nums=2
    local origin_udp_port=$(grep "vmi.webrtc.connection.udpbeginport" $DEFAULT_PROP | awk -F= '{print $2}' | tr -d '\r')
    local min_udp_port=$(($origin_udp_port+($container_id-1)*$udp_port_nums+1))
    local max_udp_port=$(($origin_udp_port+$container_id*$udp_port_nums))
    sed -i 's/\(.*\)vmi.network.type=\(.*\)/vmi.network.type='"${networktype}"'/g' $DEFAULT_PROP
    sed -i 's/\(.*\)vmi.webrtc.httpserver.port=\(.*\)/vmi.webrtc.httpserver.port='"${map_http_port}"'/g' $DEFAULT_PROP
    sed -i 's/\(.*\)vmi.webrtc.connection.udpminport=\(.*\)/vmi.webrtc.connection.udpminport='"${min_udp_port}"'/g' $DEFAULT_PROP
    sed -i 's/\(.*\)vmi.webrtc.connection.udpmaxport=\(.*\)/vmi.webrtc.connection.udpmaxport='"${max_udp_port}"'/g' $DEFAULT_PROP
    if [ "$start_cmd" == "restart" ]; then
        return
    fi
    local opt=""
    opt+=" -p ${map_http_port}:8080/tcp"
    for ((i=min_udp_port; i<=max_udp_port; i++)); do
        opt+=" -p ${i}:${i}/udp"
    done
    echo $opt
}

function container_run() {
    if [ $ENABLE_SOFT_RENDER -eq 0 ]; then
        bb_check_encode_card
    fi

    # 基本参数准备
    local image=$1
    param_check_image_id_or_name $image

    local container_id=$2
    local port=$(($container_id+8000))
    local adb_port=$(($container_id +8500))
    local container_name="${DOCKER_NAME_PREFIX}${container_id}"
    local ram_size_mb=$(($RAM_SIZE_GB * 1024))
    local cpus_string=${CPU_MAP[$((($container_id - 1) % ${#CPU_MAP[*]}))]}
    local cpus=()
    IFS=',' read -r -a cpus <<< $cpus_string
    local numa_node=($(bb_get_closest_numas ${cpus[@]}))
    local gpu_node=()
    if [ ${ENABLE_SOFT_RENDER} -ne 1 ]; then
        gpu_node=${GPU_MAP[$((($container_id - 1) % ${#GPU_MAP[*]}))]}
    fi
    local userdata_dir=${USERDATA_MAP[$((($container_id - 1) % ${#USERDATA_MAP[*]}))]}
    
    # 准备云机属性配置文件
    bb_create_build_prop
    bb_create_default_prop

    # 数据卷挂载准备
    local no_copy_usr_data=0
    local enable_nfs=0
    if [ -n "$3" ] && [ "$3" != "0" ]; then # $3 为数据卷挂载方式，0：重新创建数据卷；1：基于已有数据卷；2：挂载到NFS目录
        echo "Skip usr data copy"
        no_copy_usr_data=1
        if [ $3 -eq 2 ]; then
            echo "Use nfs mount"
            bb_check_nfs_mount "$NFS_DIR"
            enable_nfs=1
        fi
    fi
    bb_check_nfs_f2fs_conflict "$enable_nfs"

    bb_log_info "Create container: $container_name"
    $RUNTIME_CMD ps -f name=$container_name

    # 准备额外启动参数
    local opt=""
    if [ ${ENABLE_WEBRTC_CONNECTION} -eq 1 ]; then
        bb_log_info "Starting on configure WEBRTC connection"
        opt+=$(webrtc_conection_configure start)
    else 
        opt+=" -p ${port}:8888 "
    fi
    
    if [ $ENABLE_SOFT_RENDER -eq 1 ]; then
        true
    elif bb_has_amd_gpu; then
        bb_log_info "Starting on A GPU"
        if [[ ${ENCODECARD} -eq 0 ]] || [[ ${ENCODECARD} -eq 1 ]]; then
            local encs_string=${ENC_MAP[$((($container_id - 1) % ${#ENC_MAP[*]}))]}
            local encs=""
            local encs_dev=()
            IFS=',' read -r -a encs_dev <<< $encs_string
            for i in ${encs_dev[*]}; do
                encs+=" --device=${i}:${i}:rwm"
            done
            opt+=$encs
        fi
        opt+=" -e ENABLE_AMD_C2_DECODE=${ENABLE_AMD_C2_DECODE}"
    elif bb_has_xd_gpu; then
        bb_log_info "Starting on AWM GPU"
        local vpu_node=${VPU_MAP[$((($container_id - 1) % ${#VPU_MAP[*]}))]}
        local index=$((`echo ${gpu_node:16}` - 128))
        opt+=" --device=/dev/pvr_sync:/dev/pvr_sync:rwm"
        opt+=" --device=${gpu_node}:/dev/renderD190:rwm"
        opt+=" --device=/dev/ion-${index}:/dev/ion:rwm"
        opt+=" --device=${vpu_node}:/dev/vpu"
    elif bb_has_hantro_gpu; then
        bb_log_info "Starting on HANTRO GPU"
        opt+=" ENABLE_HARD_DECODE=${ENABLE_HARD_DECODE}"
    fi
    # 额外启动参数
    local extra_run_option=$opt

    BB_NAME="$container_name"
    BB_CPUS="${cpus[*]}"
    BB_NUMAS="${numa_node}"
    BB_GPUS_RENDER="${gpu_node}"
    BB_STORAGE_SIZE_GB="$STORAGE_SIZE_GB"
    BB_RAM_SIZE_MB="${ram_size_mb}"
    BB_PORTS="${adb_port}:5555"
    BB_EXTRA_RUN_OPTION="$extra_run_option"
    BB_IMAGE_NAME="$image"
    BB_USER_DATA_PATH="$userdata_dir"
    BB_ENABLE_RENDER_LAYER="$ENABLE_RENDER_LAYER"
    BB_ENABLE_F2FS="$ENABLE_F2FS"
    BB_SYSTEM_SIZE_MB="$SYSTEM_PARTITION_SIZE_MB"
    BB_ENABLE_NFS="$enable_nfs"
    BB_NFS_DIR="$NFS_DIR"
    BB_SKIP_DATA_COPY=$no_copy_usr_data

    # Step 1: 创建容器（docker create），进程未启动
    bb_create_box
    if [ $? -ne 0 ]; then
        bb_log_error "${container_name} 容器创建失败，终止后续拉起流程！"
        return 1
    fi

    # Step 2: 在容器文件系统就绪但 init 未启动的窗口期，注入配置文件
    bb_prepare_media_codecs_for_amd ${container_name}
    bb_prepare_render_layer ${container_name} "${userdata_dir}"

    # Step 3: 启动容器并执行后处理（cgroup 权限等）
    bb_start_box
    if [ $? -ne 0 ]; then
        bb_log_error "${container_name} 容器启动失败，终止后续拉起流程！"
        return 1
    fi

    bb_log_info "Initialize container ..."
    bb_wait_container_ready "$container_name" 100 0

    # 云机启动后处理
    if bb_has_amd_gpu; then
        if [ ${ENCODECARD} -eq 0 ]; then
            init_netint_t432 $container_name
    	elif [ ${ENCODECARD} -eq 1 ]; then 
	        init_quadra $container_name
        fi
    fi
    if [[ $ENABLE_RENDER_LAYER == "1" ]]; then
        # 使能渲染中间层，start容器时setprop放在base_box.sh会set property失败
        $RUNTIME_CMD exec -it ${container_name} sh -c "setprop debug.gles.layers RenderAccLayer.kbox.so"
    fi
}

function container_restart() {
    if [ $ENABLE_SOFT_RENDER -eq 0 ]; then
        bb_check_encode_card
    fi

    local container_name=$1

    bb_log_info "Restart container: $container_name"
    param_check_container_name "$container_name"

    if [ ${ENABLE_WEBRTC_CONNECTION} -eq 1 ]; then
        bb_log_info "Starting on configure WEBRTC connection"
        webrtc_conection_configure restart
    fi
    bb_create_build_prop
    bb_create_default_prop
    bb_prepare_media_codecs_for_amd $container_name

    local userdata_dir=$(bb_get_mount_dir "$container_name")

    bb_log_info "restart using mount path: $userdata_dir"
    BB_NAME="$container_name"
    BB_USER_DATA_PATH="${userdata_dir}"
    BB_RESTART_TIMES=3
    BB_ENABLE_HARD_DECODE="${ENABLE_HARD_DECODE}"
    BB_ENABLE_RENDER_LAYER="${ENABLE_RENDER_LAYER}"
    BB_ENABLE_F2FS="${ENABLE_F2FS}"
    BB_SYSTEM_SIZE_MB="${SYSTEM_PARTITION_SIZE_MB}"
    bb_restart_box
    
    # 重启阶段新增拦截逻辑,判断上方base_box的restart是否执行成功
    if [ $? -ne 0 ]; then
        bb_log_error "${container_name} 重启失败：基础环境检查未通过或发生异常！"
        return 1
    fi

    if bb_has_amd_gpu; then
        if [ ${ENCODECARD} -eq 0 ]; then
            init_netint_t432 $container_name
        elif [ ${ENCODECARD} -eq 1 ]; then
            init_quadra $container_name
        fi
    fi
}

function container_delete() {
    local container_name=$1
    local delete_image=$2
    local keep_data=$3

    bb_log_info "Remove container: $container_name"
    param_check_container_name "$container_name"

    local imageid="$($RUNTIME_CMD ps -a | grep $container_name | awk '{print $2}')"
    $RUNTIME_CMD ps | grep -q "$container_name" && $RUNTIME_CMD stop -t 0 $container_name
    $RUNTIME_CMD rm $container_name

    if [ "$delete_image" == "--image" ] ; then
        bb_log_info "Remove container image: $imageid"
        $RUNTIME_CMD rmi $imageid
    fi

    local userdata_dir=$(bb_get_mount_dir "$container_name")

    if [ "${keep_data:-0}" -eq 2 ]; then
        userdata_dir=$NFS_DIR
    fi
    
    bb_log_info "delete using mount path: $userdata_dir"
    BB_NAME="$container_name"
    BB_USER_DATA_PATH="${userdata_dir}"
    BB_KEEP_DATA="${keep_data:-0}"
    bb_delete_box

    if [ -f "${DEFAULT_PROP}_${container_name}" ]; then
        rm -f ${DEFAULT_PROP}_$container_name
    fi
}

function pushxd() {
