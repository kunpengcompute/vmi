# 批量并发执行子命令的通用辅助函数
# 用法：_batch_concurrent <subcmd> <min> <max> <count>
function _batch_concurrent() {
    local subcmd=$1 MIN=$2 MAX=$3 COUNT=$4
    local container_id
    local start_id=$MIN
    local end_id=$((start_id + $COUNT - 1))
    if [ $end_id -gt $MAX ]; then
        end_id=$MAX
    fi
    while [ $start_id -le $MAX ]; do
        for container_id in $(seq $start_id $end_id); do
            cmd="$THISDIR/cfct_video $subcmd $container_id"
            bb_log_info $cmd
            $cmd >/dev/null 2>&1 &
            pids+=($!)
        done
        wait ${pids[@]}
        start_id=$(($end_id + 1))
        end_id=$(($start_id + $COUNT - 1))
        if [ $end_id -gt $MAX ]; then
            end_id=$MAX
        fi
    done
}

function cli_qtstart() {
    _batch_concurrent tstart "$2" "$3" "$4"
}

