            VIDEO_GPU_MAP=(${VIDEO_GPU_MAP_XD2_128CORE[*]})
            VIDEO_VPU_MAP=(${VIDEO_VPU_MAP_XD2_128CORE[*]})
        elif [ ${#xd_gpus[@]} -eq 4 ]; then
