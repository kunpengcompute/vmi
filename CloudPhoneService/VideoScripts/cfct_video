        elif [ ${#hantro_gpus[@]} -eq 40 ]; then
            VIDEO_GPU_MAP=(${VIDEO_GPU_MAP_HB40_320CORE[*]})
        elif  [ ${#hantro_gpus[@]} -ne 0 ]; then
