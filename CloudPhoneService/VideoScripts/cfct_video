#===============================================================================
main() {
    init_video_env
    check_hardware_map

    case "$1" in
        start|tstart|nstart|push|pushxd|delete|tdelete|ndelete|qtstart|qtdelete|\
        restart|qstart|qdelete|qrestart|start_game_old|start_game|play_game|\
        start_sgame|play_sgame|start_ygame|play_ygame|start_bgame|play_bgame|\
        check_cap|check_res|screencap|qscreencap)
            cli_$1 "$@"
            ;;
        *)
            bb_exit_error "Unknown command: $1"
            ;;
    esac
}

main "$@"
