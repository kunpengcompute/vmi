        if [ ${CPU_BIND_MODE} -eq 0 ]; then
            VIDEO_CPU_MAP=(${VIDEO_CPU_MAP_128CORE_MODE0[*]})
        elif [ ${CPU_BIND_MODE} -eq 1 ]; then
